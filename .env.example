# Neon Postgres. The pooled URL is used by the app; the direct (unpooled) URL
# by drizzle-kit migrations and the seed script (falls back to DATABASE_URL).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Clerk user IDs of the admins: they edit the question bank and
# invite people (everyone else needs an invitation). Sign in once, open
# /forbidden, and copy the ID shown there. OWNER_CLERK_USER_IDS, the older
# name, is still read when this is unset.
ADMIN_CLERK_USER_IDS=
